# 시연용 — AI 엔진 전환 셀렉터를 켠다 (npm run dev:llm).
#
# 백엔드를 두 번 띄워 둔 상태여야 한다.
#   SPRING_PROFILES_ACTIVE=mock SERVER_PORT=8080 ./gradlew bootRun
#   SPRING_PROFILES_ACTIVE=llm  SERVER_PORT=8081 ./gradlew bootRun
#
# 배포본에는 VITE_API_BASE_LLM을 주지 않는다. EC2는 7B를 못 돌리므로
# 고를 수 있게 두면 누르는 순간 실패한다.
VITE_API_BASE=http://localhost:8080/api/v1
VITE_API_BASE_LLM=http://localhost:8081/api/v1
